#!/bin/sh

MODULE_DIR=${AICPM_MODULE_DIR:-/oem/usr/ko}
MODULES_FILE=${AICPM_MODULES_FILE:-/proc/modules}

report_error() {
	message=$1
	echo "aicpm-media-modules: $message" >&2
	logger -t aicpm-media-modules "$message" 2>/dev/null || :
}

module_loaded() {
	grep -q "^$1 " "$MODULES_FILE" 2>/dev/null
}

load_module() {
	module_name=$1
	module_path=$2
	shift 2

	module_loaded "$module_name" && return 0
	if [ ! -f "$module_path" ]; then
		report_error "missing module: $module_path"
		return 1
	fi
	if ! insmod "$module_path" "$@"; then
		report_error "failed to load: $module_path"
		return 1
	fi
}

start_modules() {
	load_module mpp_vcodec "$MODULE_DIR/mpp_vcodec.ko" || return 1
	load_module rockit "$MODULE_DIR/rockit.ko" \
		"mcu_fw_path=$MODULE_DIR/hpmcu_wrap.bin" \
		mcu_fw_addr=0xff6fe000 \
		isp_max_h=1944 || return 1
}

modules_ready() {
	module_loaded mpp_vcodec && module_loaded rockit
}

case "${1:-start}" in
	start|restart)
		start_modules
		;;
	stop)
		# Media modules are intentionally retained: unloading while ISP/VENC is
		# active can leave the hardware in an unrecoverable state until reboot.
		exit 0
		;;
	status)
		if modules_ready; then
			echo "aicpm media modules ready"
			exit 0
		fi
		echo "aicpm media modules not ready"
		exit 1
		;;
	*)
		echo "Usage: $0 {start|stop|restart|status}" >&2
		exit 2
		;;
esac
